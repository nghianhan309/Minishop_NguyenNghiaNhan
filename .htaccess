RewriteEngine On
RewriteBase /MiniShop_NguyenNghiaNhan/

# Không rewrite file và thư mục có thật
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Đưa mọi request về Entry Point index.php
RewriteRule ^(admin|client)/([a-zA-Z0-9_-]+)/([a-zA-Z0-9_-]+)/([0-9]+)$ index.php?area=$1&controller=$2&action=$3&id=$4 [QSA,L]
RewriteRule ^(admin|client)/([a-zA-Z0-9_-]+)/([a-zA-Z0-9_-]+)$ index.php?area=$1&controller=$2&action=$3 [QSA,L]
RewriteRule ^(admin|client)/([a-zA-Z0-9_-]+)$ index.php?area=$1&controller=$2&action=index [QSA,L]
RewriteRule ^(admin|client)$ index.php?area=$1&controller=dashboard&action=index [QSA,L]
RewriteRule ^ index.php [QSA,L]
